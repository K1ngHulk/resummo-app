{
  "name": "resummo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "start": "node server/index.js",
    "prebuild": "npm run db:generate",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test server/lib/articleMarkdownImport.test.mjs server/lib/contentAssetStore.test.mjs server/lib/notionDocumentNormalizer.test.mjs server/lib/notionImportService.test.mjs server/lib/notionExportImport.test.mjs server/lib/localEditorialReset.test.mjs server/lib/httpErrors.test.mjs server/lib/runtimeConfig.test.mjs server/routes/adminContentRoutes.test.mjs src/data/libraryDataCache.test.mjs src/data/libraryTree.test.mjs",
    "smoke:private-access": "node scripts/smoke-http-private-access.mjs",
    "smoke:readiness": "node scripts/smoke-http-readiness.mjs",
    "smoke:error-handling": "node scripts/smoke-http-error-handling.mjs",
    "smoke:private-surface": "node scripts/smoke-http-private-surface.mjs",
    "smoke:admin": "node scripts/smoke-http-admin.mjs",
    "smoke:library": "node scripts/smoke-http-library.mjs",
    "smoke:demo": "node scripts/smoke-http-demo-showcase.mjs",
    "smoke:article-import": "node scripts/smoke-http-article-import.mjs",
    "smoke:notion-export-local": "node scripts/smoke-notion-export-local.mjs",
    "smoke:notion-export-http": "node scripts/smoke-http-notion-export.mjs",
    "smoke:first-pack": "node scripts/smoke-http-first-learning-pack.mjs",
    "smoke:qbank": "node scripts/smoke-http-qbank.mjs",
    "verify:ci": "npm run db:validate && npm test && npm run lint && npm run smoke:private-access && npm run smoke:readiness && npm run smoke:error-handling && npm run smoke:private-surface && npm run smoke:admin && npm run smoke:library && npm run smoke:demo && npm run smoke:article-import && npm run smoke:first-pack && npm run smoke:qbank && npm run build",
    "preview": "vite preview",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:reset-editorial": "node scripts/reset-editorial-content.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": "24.14.1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "effect": "^3.21.4",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prisma": "^7.8.0",
    "vite": "^8.0.12"
  }
}
